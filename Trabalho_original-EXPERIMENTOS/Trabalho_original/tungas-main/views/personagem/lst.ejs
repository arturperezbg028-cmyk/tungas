<%- include('../cabecalho') %>

<div>
    <h3>Personagem</h3>
    <a href="/personagem/add">+ Adicionar personagem</a><br><br>

    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>Classe</th>
                <th>Nível</th>
                <th>Vida</th>
                <th>PE</th>
                <th>Sanidade</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% personagens.forEach(personagem => { %>
                <tr>
                    <td><%= personagem.ficha ? personagem.ficha.nome : 'Ficha removida' %></td>
                    <td><%= personagem.ficha ? personagem.ficha.classe : '-' %></td>
                    <td><strong>Nível <%= personagem.nivel %></strong></td>
                    <td><%= personagem.life %></td>
                    <td><%= personagem.pe %></td>
                    <td><%= personagem.san %></td>
                    <td>
                        <a href="/personagem/levelup/<%= personagem._id %>" title="Subir de Nível">⬆️</a>
                        <a href="/personagem/upd/<%= personagem._id %>" title="Editar">✏️</a>
                        <a href="/personagem/del/<%= personagem._id %>" title="Excluir">🗑️</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</body>
</html>
