<%- include('../cabecalho')%>

<div>
    <a href="/personagem"> ← Voltar </a>
    <h3>Adicionar Personagem</h3>

    <form action="/personagem/add" method="POST">
        <label for="fichaId">Escolha a Ficha:</label><br>
        <select name="fichaId" id="fichaId" required>
            <option value="">Selecione uma ficha...</option>
            <% fichas.forEach(ficha => { %>
                <option value="<%= ficha._id %>">
                    <%= ficha.nome %> - <%= ficha.classe %>
                </option>
            <% }) %>
        </select><br><br>

        <button type="submit">Salvar Personagem</button>
    </form>
</div>
</body>
</html>
