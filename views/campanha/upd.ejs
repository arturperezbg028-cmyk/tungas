<%- include('../cabecalho')%>
    <div>
        <tr><a href="/campanha"> ← Voltar </a></tr>
        <form method="post">
        <p>ID</p>
        <input type="text" name="id" value="<%=campanha.id%>" readonly>
        <br><br>
        <p>Nome da campanha</p>
        <input type="text" name="Nome_da_campanha" value="<%=campanha.nome%>">
        <br><br>
        <p>Descrição da campanha</p>
        <input type="text" name="Descricao_da_campanha" value="<%=campanha.desc%>">

        <br><br>
        <button type="submit">Adicionar</button>
        <button type="reset">Cancelar</button>
        </form>
    </div>

    </body>

    </html>