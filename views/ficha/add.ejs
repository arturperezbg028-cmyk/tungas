<%- include('../cabecalho') %>

    <div>
        <a href="/ficha"> ← Voltar </a>
        <h3>Nova Ficha</h3>

        <form method="post" action="/ficha/add">
            <p>Nome</p>
            <input type="text" name="nome" placeholder="Nome do agente..." required>

            <p>Classe</p>
            <select name="classe" required>
                <option value="">Selecione...</option>
                <option value="Combatente">Combatente</option>
                <option value="Ocultista">Ocultista</option>
                <option value="Especialista">Especialista</option>
            </select>

            <p>Origem</p>
            <input type="text" name="origem" placeholder="Origem do agente..." required>

            <p>Lore / Histórico</p>
            <textarea name="lore" placeholder="Descrição detalhada do agente..."></textarea>

            <div>
                <button type="submit">Adicionar</button>
                <button type="reset">Cancelar</button>
            </div>
        </form>
    </div>

    </body>

    </html>