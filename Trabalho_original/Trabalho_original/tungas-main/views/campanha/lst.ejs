<%- include('../cabecalho') %>

    <div>

        <form action="/campanha" method="POST">
            <input type="text" name="pesquisar" placeholder="Nome da campanha">
            <input type="submit" value="Buscar">
            <a href="/campanha">Limpar</a>
        </form>

        <!-- Abaixo continua a sua tabela ou lista normal usando 'campanhas' -->
        <%campanhas.forEach(campanha=>{%>
            <div>
                <h3>
                    <%=campanha.Nome_da_campanha%>
                </h3>
                <p>
                    <%=campanha.Descrição_da_campanha%>
                </p>
            </div>
            <% }) %>
                <h <h3>Campanhas</h3>
                    <p>Gerencie as suas campanha no site</p>
                    <a href="/campanha/add">+ Nova campanha</a><br><br>

                    <table>
                        <thead>
                            <tr>
                                <th>Nome da campanha</th>
                                <th>Descrição da campanha</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <%campanhas.forEach(campanha=>{%>
                                <tr>
                                    <td>
                                        <%=campanha.Nome_da_campanha%>
                                    </td>
                                    <td>
                                        <%=campanha.Descrição_da_campanha%>
                                    </td>
                                    <td>
                                        <a href="/campanha/upd/<%=campanha.id%>">✏️</a>
                                        <a href="/campanha/del/<%=campanha.id%>">🗑️</a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
    </div>